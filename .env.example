# catalog-import and Docker Compose read .env; environment variables take priority.
# Copy to .env locally. Never commit real credentials.
HTTP_ADDR=127.0.0.1:8080
POSTGRES_PASSWORD=smart_search_local
POSTGRES_PORT=5432
POSTGRES_DSN=postgres://smart_search:smart_search_local@localhost:5432/smart_search?sslmode=disable
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
CATALOG_PATH=./data/catalog.xml
DATA_DIR=./data
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Choose a generation model after evaluating quality and cost.
OPENAI_GENERATION_MODEL=
# Total project allowance, not a limit that resets on each process start.
OPENAI_BUDGET_USD=5.00
OPENAI_LIVE_ENABLED=false
# embedding-pilot: plan is the default; live additionally requires -mode live.
# Budget/reservations/cache persist in PostgreSQL migration 002, never reset here.
