{
  "name": "smart-search-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": { "@typescript-eslint/typescript-estree": { "minimatch": "11.0.1" } },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "lint:arch": "node scripts/check-architecture.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "generate:api": "openapi-typescript ../docs/openapi.yaml -o src/shared/api/generated/schema.ts",
    "check:api": "node scripts/check-api.mjs",
    "test:ci": "npm run check:api && node --test scripts/architecture.test.mjs && vitest run"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.7",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  }
}
